<% content_for :title, [ @issue.title, @issue.municipality_district&.name, @issue.municipality&.name ].compact_blank.uniq.join(" – ") %>
<% if @issue.description.present? %>
  <% content_for :description, truncate(strip_tags(@issue.description).squish, length: 155) %>
<% end %>
<% content_for :og_type, "article" %>
<% if @issue.photos.attached? && @issue.photos[0].representable? %>
  <% content_for :og_image, rails_representation_url(@issue.photos[0].variant(:normal)) %>
<% end %>

<%= render partial: "issues/show_issue_type_#{@issue.issue_type}", locals: { issue: @issue, activity_objects: @activity_objects } %>
