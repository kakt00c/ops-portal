<% content_for :robots, "noindex, follow" %>
<% content_for(:title, @user.responsible_subject ? "Náš profil" : "Môj profil") %>

<section class="profile">
  <% if @user.responsible_subject %>
    <%= render "responsible_subject_profile" %>
  <% else %>
    <%= render "citizen_profile" %>
  <% end %>
</section>
